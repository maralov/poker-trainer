# ── api/.env ─────────────────────────────────────────────────────────────────
# Скопіюй у api/.env і заповни. У продакшені все приходить з env платформи.

# asyncpg-драйвер обов'язковий у схемі URL.
# Railway дає DATABASE_URL у форматі postgresql://… — треба замінити на postgresql+asyncpg://…
DATABASE_URL=postgresql+asyncpg://poker:poker@localhost:5433/poker_trainer

# Окрема база для pytest (створюється автоматично в api/scripts/init-db.sql)
TEST_DATABASE_URL=postgresql+asyncpg://poker:poker@localhost:5433/poker_trainer_test

# openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# Cookie з access-токеном
COOKIE_NAME=pt_access
# Порожньо для localhost. У проді — .example.com, якщо api на піддомені того ж домену.
COOKIE_DOMAIN=
# true у проді (обов'язково при SameSite=none)
COOKIE_SECURE=false
# lax, якщо web і api на одному домені; none — якщо на різних (тоді й COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Кома-розділений список дозволених origin для CORS
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development

# ── web/.env ─────────────────────────────────────────────────────────────────
# Скопіюй у web/.env
VITE_API_URL=http://localhost:8000
