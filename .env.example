# ── web/.env ─────────────────────────────────────────────────────────────────
# Скопіюй у web/.env

# Локальна розробка: значення видає `npm run db:start`.
# Це стандартні ключі Supabase CLI — однакові у всіх і не є секретами.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Продакшен: Supabase Dashboard → Project Settings → API.
# anon-ключ публічний за призначенням — він у бандлі, і це нормально.
# Ізоляцію користувачів тримають RLS-політики, а не секретність ключа.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>

# ── НІКОЛИ не додавати сюди ───────────────────────────────────────────────────
# service_role-ключ обходить RLS. Він не має потрапляти ні в web/.env,
# ні в будь-яку змінну з префіксом VITE_ — усе з цим префіксом Vite вшиває
# в публічний бандл.
